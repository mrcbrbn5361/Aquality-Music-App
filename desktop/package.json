{
  "name": "aquality-music",
  "version": "1.0.0",
  "description": "Aquality Music - Premium music streaming for Windows & macOS",
  "main": "dist/main/main.js",
  "author": "Aquality Music Team",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && electron .",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build:installer": "npm run build && electron-builder --win nsis",
    "build:win": "npm run build && electron-builder --win",
    "build:portable": "npm run build && electron-builder --win portable",
    "build:mac": "npm run build && electron-builder --mac",
    "typecheck": "tsc --noEmit -p tsconfig.main.json"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.34.0",
    "discord-rpc": "^4.0.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.18.1",
    "7zip-bin": "^5.2.0",
    "concurrently": "^8.2.2",
    "electron": "28.3.3",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12"
  },
  "build": {
    "appId": "com.aquality.music",
    "productName": "Aquality Music",
    "copyright": "Copyright © 2026 Aquality Music Team",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "mrcbrbn5361",
      "repo": "Aquality-Music-App"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Aquality-Music-Setup-${version}-win11.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.music",
      "artifactName": "Aquality-Music-${version}-mac-${arch}.${ext}",
      "identity": null,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Aquality-Music-${version}-mac-${arch}.${ext}",
      "title": "Aquality Music"
    },
    "portable": {
      "artifactName": "Aquality-Music-Portable-${version}-win11.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Aquality Music",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "assets/installerHeader.bmp",
      "installerSidebar": "assets/installerSidebar.bmp",
      "installerHeaderIcon": "assets/icon.ico",
      "license": "../LICENSE",
      "artifactName": "Aquality-Music-Setup-${version}-win11.${ext}",
      "include": "installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ],
      "warningsAsErrors": false
    }
  }
}
